# Ditulis otomatis oleh `neon env pull` ke .env.local. Gunakan connection string pooled (-pooler) untuk aplikasi.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Opsional: connection string direct untuk migrasi. Jika kosong, skrip memakai DATABASE_URL tanpa "-pooler".
# DATABASE_URL_UNPOOLED=
# Rahasia untuk menandatangani sesi admin. Buat dengan: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Opsional: untuk fitur baca label dari gambar
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
